# Server configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Allowed CORS origins (comma-separated, add production Vercel domain e.g. https://cts.vercel.app)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://cts.vercel.app,https://ctschallenge.vercel.app

# Active AI Provider: 'groq' (default) or 'gemini'
AI_PROVIDER=groq
AI_TIMEOUT_MS=4000

# Groq API Configuration (Backend only - never commit actual key)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini API Configuration (Optional secondary provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=4000

# MongoDB Configuration (Backend only)
MONGODB_URI=mongodb://localhost:27017/chaos_to_solution

# Event & Timer Configuration
EVENT_ID=cts-2026
EVENT_ADMIN_TOKEN=your_secure_admin_token_here
