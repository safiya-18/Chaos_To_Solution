# Frontend Environment Configuration Template
# Safe for version control — do NOT put server secrets or API keys here.

# Backend REST API Base URL
# Local development: http://localhost:5000
# Production on Vercel: https://cts-backend.onrender.com (replace with your actual Render URL)
VITE_API_BASE_URL=http://localhost:5000

# Set to 'false' for live backend & MongoDB in production; 'true' for offline in-browser fixtures
VITE_USE_MOCK=false

